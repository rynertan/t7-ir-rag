  "first_claim": "\ubcf5\uc218\uc758 \uc18c\uc120\uc744 \uc774\uc6a9\ud558\uc5ec \uc81c1 \uc5f0\uc120\uc73c\ub85c \uad6c\uc131\ud558\ub294 \uc81c1 \ub2e8\uacc4;",
  "all_claims": [
    "\ubcf5\uc218\uc758 \uc18c\uc120\uc744 \uc774\uc6a9\ud558\uc5ec \uc81c1 \uc5f0\uc120\uc73c\ub85c \uad6c\uc131\ud558\ub294 \uc81c1 \ub2e8\uacc4;",
    "\uc0c1\uae30 \uc81c1 \uc5f0\uc120\uc744 \uc774\uc6a9\ud558\uc5ec \uc81c2 \uc5f0\uc120\uc73c\ub85c \uad6c\uc131\ud558\ub294 \uc81c2 \ub2e8\uacc4;",
    "\uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc744 \uc544\uc138\ud1a4\uacfc \uc54c\ucf54\uc62c\uc744 \uc774\uc6a9\ud558\uc5ec \uc138\ucc99\ud558\ub294 \uc81c3 \ub2e8\uacc4;",
    "\uc0c1\uae30 \uc81c3 \ub2e8\uacc4\ub97c \uac70\uce5c \uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc744 \uc74c\uadf9 \uc544\ud06c \uc18c\uc2a4\uac00 \uc7a5\ucc29\ub41c \uc544\ud06c \uc99d\ucc29 \uc7a5\ube44\uc5d0 \uc7a5\ucc29\ud558\ub294 \uc81c4 \ub2e8\uacc4:",
    "\uc9c4\uacf5 \uc7a5\ube44 \ub0b4\ubd80\uc5d0 10 -6 Torr \uc774\ud558\uc758 \uc9c4\uacf5\ub3c4\ub97c \ud615\uc131\ud558\ub294 \uc81c5 \ub2e8\uacc4;",
    "\uc0c1\uae30 \uc9c4\uacf5 \uc7a5\ube44 \ub0b4\ubd80\uc5d0\uc11c \uc0c1\uae30 \uc81c4 \ub2e8\uacc4\ub97c \uac70\uce5c \uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc744 \uccad\uc815\uc2dc\ud0a4\ub294 \uc81c6 \ub2e8\uacc4; \ubc0f",
    "\uc0c1\uae30 \uc9c4\uacf5 \uc7a5\ube44\uc758 \ub0b4\ubd80 \uc628\ub3c4\uac00 \uc12d\uc528 400\ub3c4 \ud658\uacbd\uc5d0\uc11c \uc9c8\ud654\ud2f0\ud0c0\ub284(TiN: Titanium nitride)\uc744 \ud3ec\ud568\ud558\ub294 \ud654\ud569\ubb3c\ub85c \uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc758 \ud45c\uba74\uc5d0 \uacbd\uc9c8 \ud53c\ub9c9\uc744 \ud615\uc131\ud558\ub294 \uc81c7 \ub2e8\uacc4\ub97c \ud3ec\ud568\ud558\uace0,",
    "\uc18c\uc120\uc740 \uad75\uae30\uac00 26~28\u339b\uc774\uace0 \uc2a4\ud14c\uc778\ub9ac\uc2a4 \uc7ac\uc9c8\uc774\uba70,",
    "\uc0c1\uae30 \uc81c1 \uc5f0\uc120\uc740 \uc18c\uc120 1\uac00\ub2e5\uc744 \uc911\uc2ec\uc5d0 \ubc30\uce58\ud558\uace0 \uc911\uc2ec\uc5d0 \ubc30\uce58\ub41c \uc18c\uc120 \uc8fc\ubcc0\uc5d0 \uc18c\uc120 6\uac00\ub2e5\uc744 \ubc30\uce58\ud558\uc5ec \ud569\uacc4 \uc18c\uc120 7\uac00\ub2e5\uc744 \uaf2c\uc544\uc11c \uad6c\uc131\ub418\uace0,",
    "\uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc740 \uc81c1 \uc5f0\uc120 1\uac1c\ub97c \uc911\uc2ec\uc5d0 \ubc30\uce58\ud558\uace0 \uc911\uc2ec\uc5d0 \ubc30\uce58\ub41c \uc81c1 \uc5f0\uc120 \uc8fc\ubcc0\uc5d0 \uc81c1 \uc5f0\uc120 6\uac1c\ub97c \ubc30\uce58\ud558\uc5ec \ud569\uacc4 \uc81c1 \uc5f0\uc120 7\uac1c\ub97c \uaf2c\uc544\uc11c \uad6c\uc131\ub41c \uac83\uc744 \ud3ec\ud568\ud558\ub294 \uc778\uccb4 \uc5f0\ubd80\uc870\uc9c1 \uc808\ub2e8\uc120 \uc81c\uc870\ubc29\ubc95.",
    "\uc81c1\ud56d\uc5d0 \uc788\uc5b4\uc11c,",
    "\uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc740 \uad75\uae30\uac00 262~280\u339b\uc778 \uac83\uc744 \ud3ec\ud568\ud558\ub294 \uc778\uccb4 \uc5f0\ubd80\uc870\uc9c1 \uc808\ub2e8\uc120 \uc81c\uc870\ubc29\ubc95.",
    "\uc81c2\ud56d\uc5d0 \uc788\uc5b4\uc11c,",
    "\uc0c1\uae30 \uc81c2 \uc5f0\uc120\uc758 \uad75\uae30\uac00 268~272\u339b\uc778 \uac83\uc744 \ud3ec\ud568\ud558\ub294 \uc778\uccb4 \uc5f0\ubd80\uc870\uc9c1 \uc808\ub2e8\uc120 \uc81c\uc870\ubc29\ubc95.",
    "\uccad\uad6c\ud56d 1 \ub0b4\uc9c0 \uccad\uad6c\ud56d 3 \uc911 \uc5b4\ub290 \ud55c \ud56d\uc5d0 \uae30\uc7ac\ub41c \uc778\uccb4 \uc5f0\ubd80\uc870\uc9c1 \uc808\ub2e8\uc120 \uc81c\uc870\ubc29\ubc95\uc73c\ub85c \uc81c\uc870\ub41c \uc778\uccb4 \uc5f0\ubd80\uc870\uc9c1 \uc808\ub2e8\uc120."
  ],
